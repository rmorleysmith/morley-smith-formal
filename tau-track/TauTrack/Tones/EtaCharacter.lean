module

public import Mathlib.NumberTheory.ModularForms.DedekindEta
public import Mathlib.NumberTheory.ModularForms.SlashActions
public import Mathlib.LinearAlgebra.Matrix.FixedDetMatrices
public import Mathlib.RingTheory.RootsOfUnity.Complex
public import TauCeti.NumberTheory.ModularForms.DedekindEta
import Mathlib.Tactic

/-!
# The characters of the modular group are the twelve tones

Every character `χ : SL(2, ℤ) → G` into a commutative group satisfies `χ(S) = χ(T)⁻³` and
`χ(T)¹² = 1`, and is determined by `χ(T)` (`char_S`, `char_T_pow_twelve`, `char_ext`). This uses only
`S² = −1`, `(ST)³ = −1` and Mathlib's generation of `SL(2, ℤ)` by `S` and `T`.

The square of the Dedekind eta function, `η² = Δ^{1/12}`, transforms in weight 1 by a character:
`η² ∣[1] γ = χ(γ) η²` for every `γ ∈ SL(2, ℤ)` (`etaSq_slash`). The set of `γ` for which `η²` is
multiplied by a scalar is a subgroup containing `T` (`η(τ + 1) = e^{2πi/24} η(τ)`) and `S` (TauCeti's
`η(−1/τ)² = −iτ η(τ)²`), hence all of `SL(2, ℤ)`. The scalar defines `etaChar : SL(2, ℤ) →* ℂ` with

  `etaChar T = e^{2πi/12}`, `etaChar S = −i = e^{2πi·9/12}`,

and every character `SL(2, ℤ) →* ℂˣ` is a power of it (`exists_eq_pow`): the character group of the
modular group is cyclic of order 12, generated by the multiplier of `Δ^{1/12}`.

In the twelve-tone reading (`Tones/Pitch.lean`): `T` is a semitone, `S` a minor third down
(`9 ≡ −3`), `ST` a whole tone down (`10 ≡ −2`), `−1 = S²` the tritone (`6`); the stabiliser of the
Gaussian point `i` (generated by `S`) maps onto the diminished seventh `{0, 3, 6, 9}`, that of the
Eisenstein point `ρ` (generated by `ST`) onto the whole-tone scale.

The abelianisation `SL(2, ℤ)^ab ≅ ℤ/12` is the classical statement behind this (from memory);
here it appears through its characters.
-/

@[expose] public section

open Complex ModularGroup Matrix.SpecialLinearGroup
open UpperHalfPlane hiding I
open scoped ModularForm MatrixGroups Real

namespace TauTrack.Tones

/-! ## Characters of `SL(2, ℤ)` -/

section Characters

theorem S_mul_S : S * S = (-1 : SL(2, ℤ)) := by
  ext i j
  fin_cases i <;> fin_cases j <;> rfl

theorem ST_pow_three : (S * T) ^ 3 = (-1 : SL(2, ℤ)) := by
  ext i j
  fin_cases i <;> fin_cases j <;> rfl

variable {G : Type*} [CommGroup G] (χ : SL(2, ℤ) →* G)

/-- `χ(S) = χ(T)⁻³` for every character. -/
theorem char_S : χ S = (χ T ^ 3)⁻¹ := by
  have h1 := congrArg χ ST_pow_three
  have h2 := congrArg χ S_mul_S
  rw [map_pow, map_mul] at h1
  rw [map_mul] at h2
  have h : (χ S * χ T) ^ 3 = χ S * χ S := h1.trans h2.symm
  have h' : χ S * χ S * (χ S * χ T ^ 3) = χ S * χ S * 1 := by
    rw [mul_one]
    conv_rhs => rw [← h]
    simp only [pow_succ, pow_zero, one_mul]
    ac_rfl
  have h'' : χ S * χ T ^ 3 = 1 := mul_left_cancel h'
  exact eq_inv_of_mul_eq_one_left h''

/-- `χ(T)¹² = 1` for every character. -/
theorem char_T_pow_twelve : χ T ^ 12 = 1 := by
  have hS4 : χ S ^ 4 = 1 := by
    have h : χ (S * S) * χ (S * S) = 1 := by
      rw [← map_mul, S_mul_S, neg_one_mul, neg_neg, map_one]
    rw [map_mul] at h
    rw [show (4 : ℕ) = 1 + 1 + 1 + 1 from rfl, pow_succ, pow_succ, pow_succ, pow_one]
    rw [← h]
    ac_rfl
  rw [char_S, inv_pow, ← pow_mul] at hS4
  exact inv_eq_one.mp hS4

/-- A character is determined by its value at `T`. -/
theorem char_ext {χ₁ χ₂ : SL(2, ℤ) →* G} (h : χ₁ T = χ₂ T) : χ₁ = χ₂ := by
  refine MonoidHom.eq_of_eqOn_dense SpecialLinearGroup.SL2Z_generators ?_
  intro x hx
  rcases hx with rfl | rfl
  · rw [char_S, char_S, h]
  · exact h

end Characters

/-! ## The multiplier of `η²` -/

section Eta

/-- `η²` on `ℍ`. -/
noncomputable def etaSq (τ : ℍ) : ℂ := ModularForm.eta τ ^ 2

theorem etaSq_ne_zero (τ : ℍ) : etaSq τ ≠ 0 :=
  pow_ne_zero 2 (ModularForm.eta_ne_zero τ.im_pos)

/-- `η(z + 1) = e^{2πi/24} η(z)`. -/
theorem eta_add_one (z : ℂ) : ModularForm.eta (z + 1) = cexp (2 * π * I / 24) * ModularForm.eta z := by
  simp only [ModularForm.eta, ModularForm.eta_q_eq_pow, Function.Periodic.qParam]
  have hq : cexp (2 * π * I * (z + 1)) = cexp (2 * π * I * z) := by
    rw [mul_add, mul_one, Complex.exp_add, Complex.exp_two_pi_mul_I, mul_one]
  rw [hq, ← mul_assoc, ← Complex.exp_add]
  congr 2
  push_cast
  ring

/-- `η² ∣[1] T = e^{2πi/12} η²`. -/
theorem etaSq_slash_T : etaSq ∣[(1 : ℤ)] T = cexp (2 * π * I / 12) • etaSq := by
  ext τ
  rw [ModularForm.SL_slash_apply, Pi.smul_apply, smul_eq_mul]
  have hT : ((T • τ : ℍ) : ℂ) = (τ : ℂ) + 1 := by
    rw [modular_T_smul, coe_vadd]
    push_cast
    ring
  have hden : denom T τ = 1 := by
    simp [denom_apply, ModularGroup.coe_T]
  rw [hden, one_zpow, mul_one, etaSq, etaSq, hT, eta_add_one, mul_pow, ← Complex.exp_nat_mul]
  congr 2
  push_cast
  ring

/-- `η² ∣[1] S = −i η²`. -/
theorem etaSq_slash_S : etaSq ∣[(1 : ℤ)] S = (-I) • etaSq := by
  ext τ
  rw [ModularForm.SL_slash_apply, Pi.smul_apply, smul_eq_mul]
  have hS : ((S • τ : ℍ) : ℂ) = -1 / (τ : ℂ) := by
    rw [modular_S_smul, coe_mk, inv_neg, neg_div, one_div]
  have hden : denom S τ = τ := by
    simp [denom_apply, ModularGroup.coe_S]
  have hτ : (τ : ℂ) ≠ 0 := ne_zero τ
  rw [hden, etaSq, etaSq, hS, TauCeti.ModularForm.eta_neg_one_div_sq τ.im_pos, zpow_neg, zpow_one]
  field_simp

/-- The elements of `SL(2, ℤ)` under which `η²` is multiplied by a scalar in weight 1. -/
def scalarSet : Subgroup SL(2, ℤ) where
  carrier := {γ | ∃ c : ℂ, etaSq ∣[(1 : ℤ)] γ = c • etaSq}
  one_mem' := ⟨1, by rw [SlashAction.slash_one, one_smul]⟩
  mul_mem' := by
    rintro γ δ ⟨c, hc⟩ ⟨d, hd⟩
    refine ⟨c * d, ?_⟩
    rw [SlashAction.slash_mul, hc, ModularForm.SL_smul_slash, hd, smul_smul]
  inv_mem' := by
    rintro γ ⟨c, hc⟩
    have hc0 : c ≠ 0 := by
      rintro rfl
      have h := congrArg (· ∣[(1 : ℤ)] γ⁻¹) hc
      simp only [← SlashAction.slash_mul, mul_inv_cancel, SlashAction.slash_one, zero_smul,
        SlashAction.zero_slash] at h
      exact etaSq_ne_zero UpperHalfPlane.I (congrFun h _)
    refine ⟨c⁻¹, ?_⟩
    have h := congrArg (· ∣[(1 : ℤ)] γ⁻¹) hc
    simp only [← SlashAction.slash_mul, mul_inv_cancel, SlashAction.slash_one,
      ModularForm.SL_smul_slash] at h
    have h2 : c⁻¹ • etaSq = etaSq ∣[(1 : ℤ)] γ⁻¹ := by
      conv_lhs => rw [h]
      rw [smul_smul, inv_mul_cancel₀ hc0, one_smul]
    exact h2.symm

theorem scalarSet_eq_top : scalarSet = ⊤ := by
  rw [eq_top_iff, ← SpecialLinearGroup.SL2Z_generators, Subgroup.closure_le]
  rintro x (rfl | rfl)
  · exact ⟨-I, etaSq_slash_S⟩
  · exact ⟨_, etaSq_slash_T⟩

theorem exists_etaSq_slash (γ : SL(2, ℤ)) : ∃ c : ℂ, etaSq ∣[(1 : ℤ)] γ = c • etaSq := by
  have h : γ ∈ scalarSet := by rw [scalarSet_eq_top]; trivial
  exact h

/-- The scalar is unique. -/
theorem smul_etaSq_inj {c d : ℂ} (h : c • etaSq = d • etaSq) : c = d := by
  have := congrFun h UpperHalfPlane.I
  simp only [Pi.smul_apply, smul_eq_mul] at this
  exact mul_right_cancel₀ (etaSq_ne_zero _) this

/-- **The multiplier of `η²`**, a character of `SL(2, ℤ)`. -/
noncomputable def etaChar : SL(2, ℤ) →* ℂ where
  toFun γ := (exists_etaSq_slash γ).choose
  map_one' := by
    have h1 := (exists_etaSq_slash 1).choose_spec
    generalize (exists_etaSq_slash 1).choose = a at h1 ⊢
    apply smul_etaSq_inj
    rw [← h1, SlashAction.slash_one, one_smul]
  map_mul' γ δ := by
    have hγ := (exists_etaSq_slash γ).choose_spec
    have hδ := (exists_etaSq_slash δ).choose_spec
    have hγδ := (exists_etaSq_slash (γ * δ)).choose_spec
    generalize (exists_etaSq_slash γ).choose = a at hγ ⊢
    generalize (exists_etaSq_slash δ).choose = b at hδ ⊢
    generalize (exists_etaSq_slash (γ * δ)).choose = c at hγδ ⊢
    apply smul_etaSq_inj
    rw [← hγδ, SlashAction.slash_mul, hγ, ModularForm.SL_smul_slash, hδ, smul_smul]

/-- **`η² ∣[1] γ = χ(γ) η²`.** -/
theorem etaSq_slash (γ : SL(2, ℤ)) : etaSq ∣[(1 : ℤ)] γ = etaChar γ • etaSq :=
  (exists_etaSq_slash γ).choose_spec

theorem etaChar_T : etaChar T = cexp (2 * π * I / 12) :=
  smul_etaSq_inj ((etaSq_slash T).symm.trans etaSq_slash_T)

theorem etaChar_S : etaChar S = -I :=
  smul_etaSq_inj ((etaSq_slash S).symm.trans etaSq_slash_S)

theorem etaChar_ne_zero (γ : SL(2, ℤ)) : etaChar γ ≠ 0 := by
  intro h
  have := etaSq_slash γ
  rw [h, zero_smul] at this
  have h2 := congrArg (· ∣[(1 : ℤ)] γ⁻¹) this
  simp only [← SlashAction.slash_mul, mul_inv_cancel, SlashAction.slash_one,
    SlashAction.zero_slash] at h2
  exact etaSq_ne_zero UpperHalfPlane.I (congrFun h2 _)

/-- The multiplier as a character with values in `ℂˣ`. -/
noncomputable def etaCharUnits : SL(2, ℤ) →* ℂˣ :=
  MonoidHom.toHomUnits etaChar

theorem coe_etaCharUnits (γ : SL(2, ℤ)) : (etaCharUnits γ : ℂ) = etaChar γ := rfl

theorem isPrimitiveRoot_etaChar_T : IsPrimitiveRoot (etaChar T) 12 := by
  rw [etaChar_T]
  have := Complex.isPrimitiveRoot_exp 12 (by norm_num)
  simpa using this

/-- **Every character of `SL(2, ℤ)` with values in `ℂˣ` is a power of the multiplier of `η²`.**
The character group of the modular group is cyclic of order 12. -/
theorem exists_eq_pow (χ : SL(2, ℤ) →* ℂˣ) : ∃ k < 12, χ = etaCharUnits ^ k := by
  have h12 : ((χ T : ℂˣ) : ℂ) ^ 12 = 1 := by
    have := char_T_pow_twelve χ
    rw [← Units.val_pow_eq_pow_val, this, Units.val_one]
  obtain ⟨k, hk, hkT⟩ := isPrimitiveRoot_etaChar_T.eq_pow_of_pow_eq_one h12
  refine ⟨k, hk, char_ext ?_⟩
  apply Units.ext
  rw [MonoidHom.pow_apply, Units.val_pow_eq_pow_val, coe_etaCharUnits, hkT]

/-- The powers `etaChar^k`, `k < 12`, are distinct: the character group has exactly 12 elements. -/
theorem etaCharUnits_pow_injective {j k : ℕ} (hj : j < 12) (hk : k < 12)
    (h : etaCharUnits ^ j = etaCharUnits ^ k) : j = k := by
  have hT := congrArg (fun χ : SL(2, ℤ) →* ℂˣ ↦ ((χ T : ℂˣ) : ℂ)) h
  simp only [MonoidHom.pow_apply, Units.val_pow_eq_pow_val, coe_etaCharUnits] at hT
  exact isPrimitiveRoot_etaChar_T.pow_inj hj hk hT

/-! ## The twelve-tone reading -/

/-- `S` is a minor third down: `etaChar S = ζ₁₂⁹`. -/
theorem etaChar_S_eq_pow : etaChar S = etaChar T ^ 9 := by
  rw [etaChar_S, etaChar_T, ← Complex.exp_nat_mul]
  have : (9 : ℕ) * (2 * π * I / 12) = 3 * π * I / 2 := by push_cast; ring
  rw [this]
  have h : cexp (3 * π * I / 2) = cexp (π * I + π * I / 2) := by ring_nf
  rw [h, Complex.exp_add, Complex.exp_pi_mul_I]
  rw [show π * I / 2 = (π / 2 : ℂ) * I by ring, Complex.exp_mul_I]
  simp [Complex.cos_pi_div_two, Complex.sin_pi_div_two]

/-- The tritone: `etaChar (−1) = ζ₁₂⁶ = −1`. -/
theorem etaChar_neg_one : etaChar (-1) = -1 := by
  rw [← S_mul_S, map_mul, etaChar_S]
  ring_nf
  rw [I_sq]

end Eta

end TauTrack.Tones
