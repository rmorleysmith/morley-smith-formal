module

public import TauTrack.Siegel.Generators
import Mathlib.Tactic

/-!
# Generation of `Sp(2n, ℤ)` by the standard generators

`standardSubgroup_eq_top`: the subgroup `standardSubgroup n` of `Sp(2n, ℤ)` generated by
`gJ = (0 −1; 1 0)`, the translations `gT S = (1 S; 0 1)` and the matrices `gU U V = (U 0; 0 Vᵀ)`
is the whole group.

## Proof

Write `e j` for the `j`-th basis vector of the first summand of `ℤⁿ ⊕ ℤⁿ`, and `H` for the
standard subgroup. For a finite set `s` of "frozen" indices, `stab s` is the subgroup of elements
of `H` fixing every `e j`, `j ∈ s`, and `Reach s v w` says that some element of `stab s` sends
`v` to `w`.

* `mem_standardSubgroup_of_fix` (induction on the set `t` of indices that are *not* frozen):
  every `M ∈ Sp(2n, ℤ)` with `M e j = e j` for all `j ∉ t` lies in `H`. If `t = ∅` then
  `M = (1 B; 0 D)`, and the symplectic relations force `D = 1` and `B` symmetric, so `M = gT B`.
  Otherwise pick `i ∈ t`; by `exists_stab_mul_fix` there is `h ∈ stab tᶜ` with `h M e i = e i`,
  and `h M` fixes one more basis vector.
* `exists_stab_mul_fix` moves `v = M e i = (a, c)` to `e i` in two phases.
  * Phase 1 (`reach_clear`): a Euclidean descent in each coordinate `k ∉ s`, using
    `gT` and `gJ gT gJ⁻¹ = (1 0; S 1)` for diagonal `S` supported at `k`, makes `c k = 0`.
    The entries `c j`, `j ∈ s`, vanish from the start because `M` preserves the symplectic form.
  * Phase 2 (`exists_unit_mulVec_eq_single`): now `v = (a, 0)`, and row `i` of `(h₁ M)⁻¹`
    gives `w` with `w ⬝ᵥ a = 1` and `w j = 0` for `j ∈ s`. A descent on `∑_{k ∉ s} |a k|` by
    transvections makes all but one entry outside `s` vanish; the remaining one is `±1`, and
    two more transvections and possibly a sign change turn `a` into the basis vector.
    The resulting `U ∈ GL(n, ℤ)` acts through `gU U U⁻¹`.
-/

@[expose] public section

open Matrix

namespace TauTrack.Siegel

variable {n : Type*} [Fintype n] [DecidableEq n]

namespace Generation

/-! ## Phase 2: `GL(n, ℤ)` acting on `ℤⁿ` -/

/-- `GLReach s a b`: some `U ∈ GL(n, ℤ)` fixing the basis vectors with index in `s`
sends `a` to `b`. -/
def GLReach (s : Finset n) (a b : n → ℤ) : Prop :=
  ∃ U : (Matrix n n ℤ)ˣ, (∀ j ∈ s, U.1 *ᵥ Pi.single j 1 = Pi.single j 1) ∧ U.1 *ᵥ a = b

theorem GLReach.refl (s : Finset n) (a : n → ℤ) : GLReach s a a :=
  ⟨1, fun j _ => by rw [Units.val_one, one_mulVec], by rw [Units.val_one, one_mulVec]⟩

theorem GLReach.trans {s : Finset n} {a b c : n → ℤ} (h₁ : GLReach s a b) (h₂ : GLReach s b c) :
    GLReach s a c := by
  obtain ⟨U, hU, rfl⟩ := h₁
  obtain ⟨V, hV, rfl⟩ := h₂
  refine ⟨V * U, fun j hj => ?_, ?_⟩
  · rw [Units.val_mul, ← mulVec_mulVec, hU j hj, hV j hj]
  · rw [Units.val_mul, mulVec_mulVec]

/-- The transvection `x ↦ x + x l • c`, for `c l = 0`. -/
def tv (c : n → ℤ) (l : n) (hc : c l = 0) : (Matrix n n ℤ)ˣ where
  val := 1 + vecMulVec c (Pi.single l 1)
  inv := 1 - vecMulVec c (Pi.single l 1)
  val_inv := by
    have h : vecMulVec c (Pi.single l (1 : ℤ)) * vecMulVec c (Pi.single l 1) = 0 := by
      rw [vecMulVec_mul_vecMulVec, single_one_dotProduct, hc]; simp
    noncomm_ring
    simp [h]
  inv_val := by
    have h : vecMulVec c (Pi.single l (1 : ℤ)) * vecMulVec c (Pi.single l 1) = 0 := by
      rw [vecMulVec_mul_vecMulVec, single_one_dotProduct, hc]; simp
    noncomm_ring
    simp [h]

theorem tv_mulVec (c : n → ℤ) (l : n) (hc : c l = 0) (x : n → ℤ) :
    (tv c l hc).1 *ᵥ x = x + x l • c := by
  simp only [tv]
  rw [add_mulVec, one_mulVec]
  ext k
  simp [mulVec, dotProduct, vecMulVec_apply, Pi.single_apply, mul_comm]

theorem GLReach.tv {s : Finset n} {l : n} (hl : l ∉ s) (c : n → ℤ) (hc : c l = 0) (a : n → ℤ) :
    GLReach s a (a + a l • c) := by
  refine ⟨Generation.tv c l hc, fun j hj => ?_, tv_mulVec c l hc a⟩
  have : j ≠ l := fun h => hl (h ▸ hj)
  rw [tv_mulVec]
  simp [this.symm]

/-- The sign change at the index `i`. -/
def flip (i : n) : (Matrix n n ℤ)ˣ where
  val := diagonal fun k => if k = i then -1 else 1
  inv := diagonal fun k => if k = i then -1 else 1
  val_inv := by
    rw [diagonal_mul_diagonal, ← diagonal_one]; congr 1; ext k; split <;> simp
  inv_val := by
    rw [diagonal_mul_diagonal, ← diagonal_one]; congr 1; ext k; split <;> simp

theorem GLReach.flip {s : Finset n} {i : n} (hi : i ∉ s) (a : n → ℤ) :
    GLReach s a fun k => if k = i then -a k else a k := by
  refine ⟨Generation.flip i, fun j hj => ?_, ?_⟩
  · have : j ≠ i := fun h => hi (h ▸ hj)
    ext k
    simp only [Generation.flip, mulVec_diagonal, Pi.single_apply]
    split_ifs <;> simp_all
  · ext k
    simp only [Generation.flip, mulVec_diagonal]
    split_ifs <;> simp

/-- A Bezout certificate for the entries of `a` outside `s`. -/
def Cert (s : Finset n) (a : n → ℤ) : Prop :=
  ∃ w : n → ℤ, w ⬝ᵥ a = 1 ∧ ∀ j ∈ s, w j = 0

theorem GLReach.cert {s : Finset n} {a b : n → ℤ} (h : GLReach s a b) (ha : Cert s a) :
    Cert s b := by
  obtain ⟨U, hU, rfl⟩ := h
  obtain ⟨w, hw, hws⟩ := ha
  refine ⟨w ᵥ* (U⁻¹).1, ?_, fun j hj => ?_⟩
  · rw [← dotProduct_mulVec, mulVec_mulVec, ← Units.val_mul, inv_mul_cancel, Units.val_one,
      one_mulVec, hw]
  · have h1 : (U⁻¹).1 *ᵥ Pi.single j 1 = Pi.single j 1 := by
      conv_lhs => rw [← hU j hj]
      rw [mulVec_mulVec, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_mulVec]
    have h2 : (w ᵥ* (U⁻¹).1) j = w ⬝ᵥ ((U⁻¹).1 *ᵥ Pi.single j 1) := by
      rw [dotProduct_mulVec, dotProduct_single_one]
    rw [h2, h1, dotProduct_single_one, hws j hj]

/-- One step of the descent: reduce `a k` modulo `a l`. -/
theorem GLReach.step {s : Finset n} {k l : n} (hk : k ∉ s) (hl : l ∉ s) (hkl : k ≠ l)
    (a : n → ℤ) (hl0 : a l ≠ 0) (hle : (a l).natAbs ≤ (a k).natAbs) :
    ∃ a', GLReach s a a' ∧
      ∑ x ∈ sᶜ, (a' x).natAbs < ∑ x ∈ sᶜ, (a x).natAbs := by
  refine ⟨_, GLReach.tv hl (Pi.single k (-(a k / a l))) (by simp [hkl.symm]) a, ?_⟩
  have hk' : (a + a l • Pi.single k (-(a k / a l)) : n → ℤ) k = a k % a l := by
    simp [Int.emod_def]; ring
  have hx : ∀ x, x ≠ k → (a + a l • Pi.single k (-(a k / a l)) : n → ℤ) x = a x := by
    intro x hx; simp [hx]
  refine Finset.sum_lt_sum (fun x _ => ?_) ⟨k, by simpa using hk, ?_⟩
  · by_cases hxk : x = k
    · subst hxk
      rw [hk']
      have := Int.emod_nonneg (a x) hl0
      have := Int.emod_lt (a x) hl0
      omega
    · rw [hx x hxk]
  · rw [hk']
    have := Int.emod_nonneg (a k) hl0
    have := Int.emod_lt (a k) hl0
    omega

/-- The descent: at most one entry outside `s` survives. -/
theorem GLReach.descent (s : Finset n) (a : n → ℤ) :
    ∃ b, GLReach s a b ∧ ∀ k ∉ s, ∀ l ∉ s, k ≠ l → b k = 0 ∨ b l = 0 := by
  induction h : ∑ x ∈ sᶜ, (a x).natAbs using Nat.strong_induction_on generalizing a with
  | _ N ih =>
    by_cases hdone : ∀ k ∉ s, ∀ l ∉ s, k ≠ l → a k = 0 ∨ a l = 0
    · exact ⟨a, GLReach.refl s a, hdone⟩
    · push Not at hdone
      obtain ⟨k, hk, l, hl, hkl, hk0, hl0⟩ := hdone
      obtain ⟨a', ha', hlt⟩ : ∃ a', GLReach s a a' ∧
          ∑ x ∈ sᶜ, (a' x).natAbs < ∑ x ∈ sᶜ, (a x).natAbs := by
        rcases le_total (a l).natAbs (a k).natAbs with hle | hle
        · exact GLReach.step hk hl hkl a hl0 hle
        · exact GLReach.step hl hk hkl.symm a hk0 hle
      obtain ⟨b, hb, hb'⟩ := ih _ (h ▸ hlt) a' rfl
      exact ⟨b, ha'.trans hb, hb'⟩

/-- Once an entry outside `s` is `±1`, the vector can be moved to a basis vector. -/
theorem GLReach.finish {s : Finset n} {i l : n} (hi : i ∉ s) (hl : l ∉ s) (b : n → ℤ)
    (hbl : b l * b l = 1) : GLReach s b (Pi.single i 1) := by
  obtain ⟨b', hb', hb'i⟩ : ∃ b', GLReach s b b' ∧ b' i = 1 := by
    by_cases hli : l = i
    · subst hli
      rcases mul_self_eq_one_iff.mp hbl with h | h
      · exact ⟨b, GLReach.refl s b, h⟩
      · exact ⟨_, GLReach.flip hl b, by simp [h]⟩
    · refine ⟨_, GLReach.tv hl (Pi.single i ((1 - b i) * b l)) (by simp [hli]) b, ?_⟩
      simp only [Pi.add_apply, Pi.smul_apply, Pi.single_eq_same, smul_eq_mul]
      linear_combination (1 - b i) * hbl
  refine hb'.trans ?_
  have := GLReach.tv hi (Pi.single i 1 - b') (by simp [hb'i]) b'
  rwa [hb'i, one_smul, add_sub_cancel] at this

/-- Phase 2: a vector with a Bezout certificate outside `s` can be moved to the basis vector
`i ∉ s` by an element of `GL(n, ℤ)` fixing the basis vectors in `s`. -/
theorem exists_unit_mulVec_eq_single {s : Finset n} {i : n} (hi : i ∉ s) (a : n → ℤ)
    (ha : Cert s a) : GLReach s a (Pi.single i 1) := by
  obtain ⟨b, hab, hb⟩ := GLReach.descent s a
  obtain ⟨w, hw, hws⟩ := hab.cert ha
  obtain ⟨l, hl0⟩ : ∃ l, w l * b l ≠ 0 := by
    by_contra hcon
    push Not at hcon
    simp [dotProduct, hcon] at hw
  have hls : l ∉ s := fun hls => hl0 (by simp [hws l hls])
  have hsum : w ⬝ᵥ b = w l * b l := by
    refine Finset.sum_eq_single l (fun k _ hkl => ?_) (by simp)
    by_cases hks : k ∈ s
    · simp [hws k hks]
    · rcases hb k hks l hls hkl with h | h
      · simp [h]
      · simp [h] at hl0
  rw [hsum] at hw
  have hbl : b l * b l = 1 := by
    rcases Int.isUnit_iff.mp (IsUnit.of_mul_eq_one _ ((mul_comm _ _).trans hw)) with h | h <;>
      simp [h]
  exact hab.trans (GLReach.finish hi hls b hbl)

/-! ## The stabiliser of the frozen basis vectors in the standard subgroup -/

/-- The basis vector `e j` of the first summand of `ℤⁿ ⊕ ℤⁿ`. -/
def e (j : n) : n ⊕ n → ℤ := Sum.elim (Pi.single j 1) 0

omit [Fintype n] in
theorem e_eq_single (j : n) : e j = Pi.single (Sum.inl j) 1 := by
  ext x
  cases x <;> simp [e, Pi.single_apply]

theorem mulVec_e (M : Matrix (n ⊕ n) (n ⊕ n) ℤ) (j : n) (x : n ⊕ n) :
    (M *ᵥ e j) x = M x (Sum.inl j) := by
  rw [e_eq_single, mulVec_single_one]; rfl

theorem fromBlocks_mulVec_e (A B C D : Matrix n n ℤ) (j : n) :
    fromBlocks A B C D *ᵥ e j = Sum.elim (A *ᵥ Pi.single j 1) (C *ᵥ Pi.single j 1) := by
  simp only [e, fromBlocks_mulVec, Sum.elim_comp_inl, Sum.elim_comp_inr, mulVec_zero, add_zero]

/-- The elements of `Sp(2n, ℤ)` fixing `e j` for every `j ∈ s`. -/
def fixer (s : Finset n) : Subgroup (symplecticGroup n ℤ) where
  carrier := {h | ∀ j ∈ s, h.1 *ᵥ e j = e j}
  mul_mem' {g h} hg hh j hj := by
    rw [Submonoid.coe_mul, ← mulVec_mulVec, hh j hj, hg j hj]
  one_mem' j _ := by rw [Submonoid.coe_one, one_mulVec]
  inv_mem' {h} hh j hj := by
    conv_lhs => rw [← hh j hj]
    rw [mulVec_mulVec, ← Submonoid.coe_mul, inv_mul_cancel, Submonoid.coe_one, one_mulVec]

theorem mem_fixer {s : Finset n} {h : symplecticGroup n ℤ} :
    h ∈ fixer s ↔ ∀ j ∈ s, h.1 *ᵥ e j = e j := Iff.rfl

/-- The elements of the standard subgroup fixing `e j` for every `j ∈ s`. -/
def stab (s : Finset n) : Subgroup (symplecticGroup n ℤ) := standardSubgroup n ⊓ fixer s

/-- `Reach s v w`: some element of `stab s` sends `v` to `w`. -/
def Reach (s : Finset n) (v w : n ⊕ n → ℤ) : Prop := ∃ h ∈ stab s, h.1 *ᵥ v = w

theorem Reach.refl (s : Finset n) (v : n ⊕ n → ℤ) : Reach s v v :=
  ⟨1, one_mem _, by rw [Submonoid.coe_one, one_mulVec]⟩

theorem Reach.trans {s : Finset n} {u v w : n ⊕ n → ℤ} (h₁ : Reach s u v) (h₂ : Reach s v w) :
    Reach s u w := by
  obtain ⟨g, hg, rfl⟩ := h₁
  obtain ⟨h, hh, rfl⟩ := h₂
  exact ⟨h * g, mul_mem hh hg, by rw [Submonoid.coe_mul, mulVec_mulVec]⟩

theorem gJ_mem : (gJ : symplecticGroup n ℤ) ∈ standardSubgroup n :=
  Subgroup.subset_closure (Or.inl rfl)

theorem gT_mem (S : Matrix n n ℤ) (hS : S.IsSymm) : gT S hS ∈ standardSubgroup n :=
  Subgroup.subset_closure (Or.inr (Or.inl ⟨S, hS, rfl⟩))

theorem gU_mem (U : (Matrix n n ℤ)ˣ) : gU U.1 (U⁻¹).1 (Units.inv_mul U) ∈ standardSubgroup n :=
  Subgroup.subset_closure (Or.inr (Or.inr ⟨U.1, (U⁻¹).1, Units.inv_mul U, Units.mul_inv U, rfl⟩))

/-- The matrix `(1 0; S 1)` in `Sp(2n, ℤ)`, for `S` symmetric. -/
def gL (S : Matrix n n ℤ) (hS : S.IsSymm) : symplecticGroup n ℤ :=
  ⟨fromBlocks 1 0 S 1, SymplecticGroup.fromBlocks_mem_iff.mpr
    ⟨by simp [hS.eq], by simp, by simp⟩⟩

theorem gL_mem (S : Matrix n n ℤ) (hS : S.IsSymm) : gL S hS ∈ standardSubgroup n := by
  have h : gJ * gT (-S) hS.neg = gL S hS * gJ := by
    apply Subtype.ext
    simp [gJ, gT, gL, fromBlocks_multiply]
  rw [eq_mul_inv_of_mul_eq h.symm]
  exact mul_mem (mul_mem gJ_mem (gT_mem _ _)) (inv_mem gJ_mem)

theorem reach_T (s : Finset n) (S : Matrix n n ℤ) (hS : S.IsSymm) (a c : n → ℤ) :
    Reach s (Sum.elim a c) (Sum.elim (a + S *ᵥ c) c) := by
  refine ⟨gT S hS, ⟨gT_mem S hS, fun j hj => ?_⟩, ?_⟩
  · rw [show (gT S hS).1 = fromBlocks 1 S 0 1 from rfl, fromBlocks_mulVec_e, one_mulVec,
      zero_mulVec]
    rfl
  · simp [gT, fromBlocks_mulVec]

theorem reach_L (s : Finset n) (S : Matrix n n ℤ) (hS : S.IsSymm)
    (hS0 : ∀ j ∈ s, S *ᵥ Pi.single j 1 = 0) (a c : n → ℤ) :
    Reach s (Sum.elim a c) (Sum.elim a (c + S *ᵥ a)) := by
  refine ⟨gL S hS, ⟨gL_mem S hS, fun j hj => ?_⟩, ?_⟩
  · rw [show (gL S hS).1 = fromBlocks 1 0 S 1 from rfl, fromBlocks_mulVec_e, one_mulVec,
      hS0 j hj]
    rfl
  · simp [gL, fromBlocks_mulVec, add_comm]

theorem reach_U {s : Finset n} (U : (Matrix n n ℤ)ˣ)
    (hU : ∀ j ∈ s, U.1 *ᵥ Pi.single j 1 = Pi.single j 1) (a c : n → ℤ) :
    Reach s (Sum.elim a c) (Sum.elim (U.1 *ᵥ a) ((U⁻¹).1ᵀ *ᵥ c)) := by
  refine ⟨gU U.1 (U⁻¹).1 (Units.inv_mul U), ⟨gU_mem U, fun j hj => ?_⟩, ?_⟩
  · rw [show (gU U.1 (U⁻¹).1 (Units.inv_mul U)).1 = fromBlocks U.1 0 0 (U⁻¹).1ᵀ from rfl,
      fromBlocks_mulVec_e, hU j hj, zero_mulVec]
    rfl
  · simp [gU, fromBlocks_mulVec]

theorem diagonal_single_mulVec (k : n) (t : ℤ) (c : n → ℤ) :
    diagonal (Pi.single k t) *ᵥ c = Pi.single k (t * c k) := by
  ext x
  rw [mulVec_diagonal]
  by_cases h : x = k
  · subst h; simp
  · simp [h]

theorem reach_T' (s : Finset n) (k : n) (t : ℤ) (a c : n → ℤ) :
    Reach s (Sum.elim a c) (Sum.elim (a + Pi.single k (t * c k)) c) := by
  have := reach_T s (diagonal (Pi.single k t)) (isSymm_diagonal _) a c
  rwa [diagonal_single_mulVec] at this

theorem reach_L' {s : Finset n} {k : n} (hk : k ∉ s) (t : ℤ) (a c : n → ℤ) :
    Reach s (Sum.elim a c) (Sum.elim a (c + Pi.single k (t * a k))) := by
  have := reach_L s (diagonal (Pi.single k t)) (isSymm_diagonal _) (fun j hj => by
    have : k ≠ j := fun h => hk (h ▸ hj)
    rw [diagonal_single_mulVec]; simp [this]) a c
  rwa [diagonal_single_mulVec] at this

/-! ## Phase 1: clearing the second half of the vector -/

/-- Euclid's algorithm in the coordinate `k ∉ s`. -/
theorem reach_euclid {s : Finset n} {k : n} (hk : k ∉ s) (a c : n → ℤ) :
    ∃ a' c', Reach s (Sum.elim a c) (Sum.elim a' c') ∧ c' k = 0 ∧ ∀ x, x ≠ k → c' x = c x := by
  induction h : (c k).natAbs using Nat.strong_induction_on generalizing a c with
  | _ N ih =>
    by_cases hc : c k = 0
    · exact ⟨a, c, Reach.refl _ _, hc, fun _ _ => rfl⟩
    have h1 := reach_T' s k (-(a k / c k)) a c
    obtain ⟨a1, ha1⟩ : ∃ a1, a1 = a + Pi.single k (-(a k / c k) * c k) := ⟨_, rfl⟩
    rw [← ha1] at h1
    have ha1k : a1 k = a k % c k := by
      simp [ha1, Int.emod_def]; ring
    by_cases hz : a1 k = 0
    · have h2 := reach_T' s k 1 a1 c
      have h3 := reach_L' hk (-1) (a1 + Pi.single k (1 * c k)) c
      refine ⟨_, _, h1.trans (h2.trans h3), ?_, fun x hx => ?_⟩
      · simp [hz]
      · simp [hx]
    · have h2 := reach_L' hk (-(c k / a1 k)) a1 c
      obtain ⟨c2, hc2⟩ : ∃ c2, c2 = c + Pi.single k (-(c k / a1 k) * a1 k) := ⟨_, rfl⟩
      rw [← hc2] at h2
      have hc2k : c2 k = c k % a1 k := by
        simp [hc2, Int.emod_def]; ring
      have hlt : (c2 k).natAbs < N := by
        have h3 := Int.emod_nonneg (c k) hz
        have h4 := Int.emod_lt (c k) hz
        have h5 := Int.emod_nonneg (a k) hc
        have h6 := Int.emod_lt (a k) hc
        rw [← hc2k] at h3 h4
        rw [← ha1k] at h5 h6
        omega
      obtain ⟨a', c', hr, hk0, hx⟩ := ih _ hlt a1 c2 rfl
      exact ⟨a', c', h1.trans (h2.trans hr), hk0, fun x hxk => by
        rw [hx x hxk, hc2]; simp [hxk]⟩

/-- Phase 1: the entries `c k`, `k ∈ t`, can be cleared when `t` is disjoint from `s`. -/
theorem reach_clear (s t : Finset n) (ht : ∀ k ∈ t, k ∉ s) (a c : n → ℤ) :
    ∃ a' c', Reach s (Sum.elim a c) (Sum.elim a' c') ∧ (∀ k ∈ t, c' k = 0) ∧
      ∀ x, x ∉ t → c' x = c x := by
  induction t using Finset.induction_on generalizing a c with
  | empty => exact ⟨a, c, Reach.refl _ _, by simp, fun _ _ => rfl⟩
  | insert k t hkt ih =>
    obtain ⟨a1, c1, h1, h1t, h1x⟩ := ih (fun k hk => ht k (Finset.mem_insert_of_mem hk)) a c
    obtain ⟨a2, c2, h2, h2k, h2x⟩ := reach_euclid (ht k (Finset.mem_insert_self _ _)) a1 c1
    refine ⟨a2, c2, h1.trans h2, fun x hx => ?_, fun x hx => ?_⟩
    · by_cases hxk : x = k
      · rw [hxk]; exact h2k
      · rw [h2x x hxk]; exact h1t x (Finset.mem_of_mem_insert_of_ne hx hxk)
    · rw [Finset.mem_insert, not_or] at hx
      rw [h2x x hx.1, h1x x hx.2]

/-! ## The vector lemma and the induction on the frozen set -/

/-- If `M` is symplectic and fixes `e j`, then the `j`-th entry of the second half of `M e i`
vanishes. -/
theorem inr_eq_zero_of_fix (M : symplecticGroup n ℤ) {i j : n} (hj : M.1 *ᵥ e j = e j) :
    (M.1 *ᵥ e i) (Sum.inr j) = 0 := by
  have hJ : M.1ᵀ * J n ℤ * M.1 = J n ℤ := SymplecticGroup.mem_iff'.mp M.2
  have key : (M.1 *ᵥ e j) ⬝ᵥ (J n ℤ *ᵥ (M.1 *ᵥ e i)) = e j ⬝ᵥ (J n ℤ *ᵥ e i) := by
    rw [← vecMul_transpose, mulVec_mulVec, dotProduct_mulVec, vecMul_vecMul, ← Matrix.mul_assoc,
      hJ, ← dotProduct_mulVec]
  rw [hj, e_eq_single j, single_one_dotProduct, single_one_dotProduct, mulVec_e] at key
  rw [J, fromBlocks_mulVec] at key
  simpa [neg_mulVec] using key

/-- Row `i` of the inverse of `N` is a Bezout certificate for `N e i`. -/
theorem cert_of_fix {s : Finset n} {i : n} (hi : i ∉ s) (N : symplecticGroup n ℤ)
    (hN : N ∈ fixer s) (a : n → ℤ) (ha : N.1 *ᵥ e i = Sum.elim a 0) : Cert s a := by
  refine ⟨fun k => (N⁻¹).1 (Sum.inl i) (Sum.inl k), ?_, fun j hj => ?_⟩
  · have h : ((N⁻¹).1 *ᵥ (N.1 *ᵥ e i)) (Sum.inl i) = 1 := by
      rw [mulVec_mulVec, ← Submonoid.coe_mul, inv_mul_cancel, Submonoid.coe_one, one_mulVec]
      simp [e]
    rw [ha] at h
    simpa [mulVec, dotProduct, Fintype.sum_sum_type] using h
  · have h := congrFun ((fixer s).inv_mem hN j hj) (Sum.inl i)
    rw [mulVec_e] at h
    have hji : i ≠ j := fun h => hi (h ▸ hj)
    change (N⁻¹).1 (Sum.inl i) (Sum.inl j) = 0
    rw [h]
    simp [e, hji]

/-- The vector lemma: `M e i` can be moved back to `e i` inside `stab s`. -/
theorem exists_stab_mul_fix {s : Finset n} {i : n} (hi : i ∉ s) (M : symplecticGroup n ℤ)
    (hM : M ∈ fixer s) : ∃ h ∈ stab s, (h * M).1 *ᵥ e i = e i := by
  have hc : ∀ j ∈ s, ((M.1 *ᵥ e i) ∘ Sum.inr) j = 0 := fun j hj =>
    inr_eq_zero_of_fix M (hM j hj)
  obtain ⟨a', c', hr, hc0, hcx⟩ := reach_clear s sᶜ (by simp)
    ((M.1 *ᵥ e i) ∘ Sum.inl) ((M.1 *ᵥ e i) ∘ Sum.inr)
  rw [Sum.elim_comp_inl_inr] at hr
  have hc' : c' = 0 := by
    ext x
    by_cases hx : x ∈ s
    · rw [hcx x (by simpa using hx)]; exact hc x hx
    · exact hc0 x (by simpa using hx)
  subst hc'
  obtain ⟨h1, hh1, h1v⟩ := hr
  have hN : h1 * M ∈ fixer s := mul_mem hh1.2 hM
  have hNe : (h1 * M).1 *ᵥ e i = Sum.elim a' 0 := by
    rw [Submonoid.coe_mul, ← mulVec_mulVec, h1v]
  obtain ⟨U, hU, hUa⟩ := exists_unit_mulVec_eq_single hi a' (cert_of_fix hi _ hN a' hNe)
  obtain ⟨h2, hh2, h2v⟩ := reach_U U hU a' 0
  refine ⟨h2 * h1, mul_mem hh2 hh1, ?_⟩
  rw [mul_assoc, Submonoid.coe_mul, ← mulVec_mulVec, hNe, h2v, hUa]
  simp [e]

/-- A symplectic matrix fixing every `e j` is a translation `gT B`. -/
theorem mem_standardSubgroup_of_fix_all (M : symplecticGroup n ℤ)
    (hM : ∀ j, M.1 *ᵥ e j = e j) : M ∈ standardSubgroup n := by
  have h11 : M.1.toBlocks₁₁ = 1 := by
    ext x y
    have := congrFun (hM y) (Sum.inl x)
    rw [mulVec_e] at this
    change M.1 (Sum.inl x) (Sum.inl y) = (1 : Matrix n n ℤ) x y
    rw [this, e, Sum.elim_inl, Pi.single_apply]
    exact Matrix.one_apply.symm
  have h21 : M.1.toBlocks₂₁ = 0 := by
    ext x y
    have := congrFun (hM y) (Sum.inr x)
    rw [mulVec_e] at this
    simpa [toBlocks₂₁, e] using this
  have hM' : M.1 = fromBlocks 1 M.1.toBlocks₁₂ 0 M.1.toBlocks₂₂ := by
    rw [← h11, ← h21, fromBlocks_toBlocks]
  have hmem := M.2
  rw [hM', SymplecticGroup.fromBlocks_mem_iff] at hmem
  obtain ⟨-, h2, h3⟩ := hmem
  have hD : M.1.toBlocks₂₂ = 1 := by simpa using h3
  rw [hD] at h2
  have hB : M.1.toBlocks₁₂.IsSymm := by
    change M.1.toBlocks₁₂ᵀ = M.1.toBlocks₁₂
    simpa using h2
  have hMT : M = gT _ hB := Subtype.ext (hM'.trans (by rw [hD]; rfl))
  rw [hMT]
  exact gT_mem _ _

/-- Every symplectic matrix fixing `e j` for all `j ∉ t` lies in the standard subgroup. -/
theorem mem_standardSubgroup_of_fix (t : Finset n) :
    ∀ M : symplecticGroup n ℤ, M ∈ fixer tᶜ → M ∈ standardSubgroup n := by
  induction t using Finset.induction_on with
  | empty =>
    intro M hM
    exact mem_standardSubgroup_of_fix_all M fun j => hM j (by simp)
  | insert i t hit ih =>
    intro M hM
    obtain ⟨h, hh, hfix⟩ := exists_stab_mul_fix (s := (insert i t)ᶜ) (i := i) (by simp) M hM
    have hmem : h * M ∈ standardSubgroup n := ih _ fun j hj => by
      by_cases hji : j = i
      · rw [hji]; exact hfix
      · exact mul_mem hh.2 hM j (by simpa [hji] using hj)
    exact (Subgroup.mul_mem_cancel_left _ hh.1).mp hmem

end Generation

/-- **Generation of `Sp(2n, ℤ)`**: the matrices `(0 −1; 1 0)`, `(1 S; 0 1)` with `S` symmetric
and `(U 0; 0 U⁻ᵀ)` with `U ∈ GL(n, ℤ)` generate the integral symplectic group. -/
theorem standardSubgroup_eq_top (n : Type*) [Fintype n] [DecidableEq n] :
    standardSubgroup n = ⊤ :=
  eq_top_iff.mpr fun M _ =>
    Generation.mem_standardSubgroup_of_fix Finset.univ M fun j hj => absurd hj (by simp)

end TauTrack.Siegel
