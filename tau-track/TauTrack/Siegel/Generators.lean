module

public import Mathlib.LinearAlgebra.SymplecticGroup

/-!
# The standard generators of `Sp(2n, ℤ)`

* `gJ = (0 −1; 1 0)`;
* `gT S = (1 S; 0 1)`, `S` symmetric integral;
* `gU U V = (U 0; 0 Vᵀ)`, `U V = V U = 1` integral;
* `standardGenerators n`, the set of all of these, and `standardSubgroup n`, the subgroup they
  generate. `Generation.lean` proves `standardSubgroup n = ⊤`.

This file and `Generation.lean` import only Mathlib.
-/

@[expose] public section

open Matrix

namespace TauTrack.Siegel

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- `J = (0 −1; 1 0)` in `Sp(2n, ℤ)`. -/
def gJ : symplecticGroup n ℤ := ⟨fromBlocks 0 (-1) 1 0, SymplecticGroup.J_mem n ℤ⟩

/-- The translation `(1 S; 0 1)` in `Sp(2n, ℤ)`, for `S` symmetric. -/
def gT (S : Matrix n n ℤ) (hS : S.IsSymm) : symplecticGroup n ℤ :=
  ⟨fromBlocks 1 S 0 1, SymplecticGroup.fromBlocks_mem_iff.mpr
    ⟨by simp, by simp [hS.eq], by simp⟩⟩

/-- The matrix `(U 0; 0 Vᵀ)` in `Sp(2n, ℤ)`, for `U V = V U = 1`. -/
def gU (U V : Matrix n n ℤ) (hVU : V * U = 1) : symplecticGroup n ℤ :=
  ⟨fromBlocks U 0 0 Vᵀ, SymplecticGroup.fromBlocks_mem_iff.mpr
    ⟨by simp, by simp, by simp [← Matrix.transpose_mul, hVU]⟩⟩

/-- The set of standard generators of `Sp(2n, ℤ)`. -/
def standardGenerators (n : Type*) [Fintype n] [DecidableEq n] : Set (symplecticGroup n ℤ) :=
  {γ | γ = gJ ∨ (∃ S hS, γ = gT S hS) ∨ ∃ U V, ∃ hVU : V * U = 1, U * V = 1 ∧ γ = gU U V hVU}

/-- The subgroup of `Sp(2n, ℤ)` generated by `J`, the translations and the image of `GL(n, ℤ)`.
It is all of `Sp(2n, ℤ)`: `standardSubgroup_eq_top` in `Generation.lean`. -/
def standardSubgroup (n : Type*) [Fintype n] [DecidableEq n] : Subgroup (symplecticGroup n ℤ) :=
  Subgroup.closure (standardGenerators n)

end TauTrack.Siegel
