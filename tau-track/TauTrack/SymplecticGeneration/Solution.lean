module

public import Mathlib
public import TauTrack.Siegel.Generation

/-!
# Solution: `Sp(2n, ℤ)` is generated by `J`, the translations and `GL(n, ℤ)`

Let `n` be a finite type. The integral symplectic group `Sp(2n, ℤ)` (Mathlib's
`Matrix.symplecticGroup n ℤ`, matrices `M` over `ℤ` indexed by `n ⊕ n` with `M J Mᵀ = J`) is
generated by three kinds of block matrix:

* `J = (0 −1; 1 0)`;
* the translations `(1 S; 0 1)` with `S` symmetric;
* the matrices `(U 0; 0 Vᵀ)` with `U V = V U = 1`, that is, the image of `GL(n, ℤ)`.

This is the classical generation theorem for the Siegel modular group. Only Mathlib definitions
are used. This file restates `Challenge.lean` word for word and proves it from `TauTrack/Siegel/Generation.lean`.
-/

@[expose] public section

namespace SymplecticGeneration

theorem closure_eq_top (n : Type*) [Fintype n] [DecidableEq n] :
    Subgroup.closure
      {γ : Matrix.symplecticGroup n ℤ |
        (γ : Matrix (n ⊕ n) (n ⊕ n) ℤ) = Matrix.fromBlocks 0 (-1) 1 0 ∨
        (∃ S : Matrix n n ℤ, S.IsSymm ∧
          (γ : Matrix (n ⊕ n) (n ⊕ n) ℤ) = Matrix.fromBlocks 1 S 0 1) ∨
        ∃ U V : Matrix n n ℤ, U * V = 1 ∧ V * U = 1 ∧
          (γ : Matrix (n ⊕ n) (n ⊕ n) ℤ) = Matrix.fromBlocks U 0 0 V.transpose} = ⊤ := by
  rw [eq_top_iff, ← TauTrack.Siegel.standardSubgroup_eq_top n]
  refine Subgroup.closure_mono ?_
  rintro γ (rfl | ⟨S, hS, rfl⟩ | ⟨U, V, hVU, hUV, rfl⟩)
  · exact Or.inl rfl
  · exact Or.inr (Or.inl ⟨S, hS, rfl⟩)
  · exact Or.inr (Or.inr ⟨U, V, hUV, hVU, rfl⟩)

end SymplecticGeneration
